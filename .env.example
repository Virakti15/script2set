# Backend only. Never commit .env or real keys.
APP_ENV=local
HOST=127.0.0.1
PORT=5000
SECRET_KEY=
APP_ACCESS_PASSWORD=
# Production: an absolute path on a mounted persistent disk.
DATA_DIR=./data
# Exact frontend origins, comma separated. HTTPS in production. No wildcard.
FRONTEND_ORIGINS=
# demo = labelled offline rules; ollama = local; openai = cloud.
AI_PROVIDER=demo
AI_TIMEOUT=90
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# none never simulates generated images. Uploads still work.
IMAGE_PROVIDER=none
IMAGE_BASE_URL=https://api.openai.com/v1
# Optional separate key; otherwise uses OPENAI_API_KEY.
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=low
IMAGE_TIMEOUT=180
# Netlify BUILD environment only; public backend origin, never a secret.
PUBLIC_API_BASE_URL=
